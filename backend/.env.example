# ==============================================================================
# CityMind AI — Backend Environment Configuration Template
# ==============================================================================
# Instructions: Copy this file to .env and replace placeholder values with your
# local or cloud credentials. DO NOT commit .env into version control.

# Application Metadata
PROJECT_NAME="CityMind AI"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL AsyncPG)
# Example for local PostgreSQL: postgresql+asyncpg://postgres:your_password@localhost:5432/citymind_ai
# Example for Neon/Supabase: postgresql+asyncpg://user:pass@ep-cool-fog-12345.us-east-2.aws.neon.tech/citymind_ai?ssl=require
# Example for local async SQLite (dev/test): sqlite+aiosqlite:///./citymind.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/citymind_ai

# Security & JWT Configuration
# Generate a cryptographically secure 256-bit key using: openssl rand -hex 32
JWT_SECRET=replace_this_with_a_secure_random_secret_key_minimum_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
